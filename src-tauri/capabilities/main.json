{
  "identifier": "main-capability",
  "description": "permissions granted to the main window",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",

    "core:event:default",

    "dialog:allow-save",
    "dialog:allow-open",

    "core:window:default",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",

    "core:app:default",

    "core:resources:default",

    "core:menu:default",

    "core:tray:default",

    "window-state:default",

    "shell:allow-open",

    "clipboard-manager:allow-write-text",

    "http:allow-fetch",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    },

    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**" }]
    },
    "fs:default",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:write-all",
    "fs:write-files",

    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "run-extension",
          "cmd": "node",
          "args": ["extensions-runner/runner.js", { "validator": "\\S+" }]
        }
      ]
    }
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ]
}
